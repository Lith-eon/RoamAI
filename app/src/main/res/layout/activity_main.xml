<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <!-- Camera Preview View (Takes up entire screen) -->

    <!-- Floating HUD Settings Button Top-Right -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreviewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSettings"
        style="@style/Widget.Material3.Button.Icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:padding="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        app:icon="@drawable/ic_settings"
        app:iconGravity="textStart"
        app:iconSize="24dp"
        app:iconPadding="0dp"
        app:backgroundTint="#650014"
        app:iconTint="#FFF3B6"
        app:cornerRadius="28dp"
        android:contentDescription="@string/btn_settings" />

    <!-- Live Status Badge Overlaid Top-Center -->
    <LinearLayout
        android:id="@+id/layoutStatusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_translucent_badge"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <View
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:background="@drawable/gemini_icon" />

        <TextView
            android:id="@+id/tvLiveStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Gemini Live: Off"
            android:textColor="#FFF3B6"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Zoom Controls Overlaid Right-Center -->
    <LinearLayout
        android:id="@+id/layoutZoomControls"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_translucent_badge"
        android:orientation="vertical"
        android:padding="6dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZoom1x"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="1x"
            android:textColor="#FFF3B6"
            android:textSize="12sp"
            android:textStyle="bold"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:cornerRadius="22dp"
            app:backgroundTint="#40C11F25" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZoom2x"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:text="2x"
            android:textColor="#FFF3B6"
            android:textSize="12sp"
            android:textStyle="bold"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:cornerRadius="22dp"
            app:backgroundTint="#00000000" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZoom5x"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:text="5x"
            android:textColor="#FFF3B6"
            android:textSize="12sp"
            android:textStyle="bold"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:cornerRadius="22dp"
            app:backgroundTint="#00000000" />
    </LinearLayout>

    <!-- Bottom Container: AI Result Card + Loading + HUD Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- AI Insight Result Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#650014"
            app:strokeColor="#C11F25"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_sparkles"
                        app:tint="#FFF3B6"
                        android:contentDescription="AI Icon" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Live Gemini AI Discovery"
                        android:textColor="#FFF3B6"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyText"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        app:icon="@drawable/ic_copy"
                        app:iconTint="#FFF3B6"
                        android:contentDescription="@string/btn_copy" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShareText"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        app:icon="@drawable/ic_share"
                        app:iconTint="#FFF3B6"
                        android:contentDescription="@string/btn_share" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="#C11F25" />

                <TextView
                    android:id="@+id/tvDescriptionResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFF3B6"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:textIsSelectable="true"
                    tools:text="Point your camera at an object or scene to get an excited Gemini analysis!" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Loading Indicator Bar -->
        <LinearLayout
            android:id="@+id/layoutLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_translucent_badge"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminate="true"
                app:indicatorColor="#C11F25"
                app:trackColor="#650014" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Gemini is analyzing live camera feed..."
                android:textColor="#FFF3B6"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Bottom Controls Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleFlash"
                style="@style/Widget.Material3.Button.Icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:icon="@drawable/flash_off"
                app:iconGravity="textStart"
                app:iconSize="24dp"
                app:iconPadding="0dp"
                app:backgroundTint="#650014"
                app:iconTint="#FFF3B6"
                app:cornerRadius="28dp"
                android:contentDescription="@string/btn_flash" />

            <!-- Prominent Gemini Live Toggle / Analyze Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleGeminiLive"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="Turn On Gemini AI"
                android:textColor="#FFF3B6"
                android:textSize="14sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_sparkles"
                app:iconSize="20dp"
                app:iconTint="#FFF3B6"
                app:backgroundTint="#C11F25"
                app:cornerRadius="28dp" />

            <!-- Turn Off Gemini Button (Visible in Manual Mode when Gemini is ON) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTurnOffGemini"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="Turn Off"
                android:textColor="#FFF3B6"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingHorizontal="16dp"
                android:visibility="gone"
                app:backgroundTint="#650014"
                app:cornerRadius="28dp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
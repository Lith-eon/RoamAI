<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A10"
    android:fitsSystemWindows="true">

    <!-- Camera Preview View (Takes up most/all of the screen) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreviewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fillCenter" />

        <!-- Selected Gallery Image View Overlay -->
        <ImageView
            android:id="@+id/ivSelectedImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="Selected Image" />

    </FrameLayout>

    <!-- Translucent Top Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#60000000"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name"
            app:titleTextColor="#FFFFFF"
            app:subtitle="Live Gemini Vision Feed"
            app:subtitleTextColor="#D0D0E0"
            app:logo="@drawable/ic_sparkles" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Overlay Controls and AI Output Container -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="?attr/actionBarSize">

        <!-- Live Status Badge Overlaid Top-Center -->
        <LinearLayout
            android:id="@+id/layoutStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_translucent_badge"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <View
                android:id="@+id/viewStatusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/shape_dot_off" />

            <TextView
                android:id="@+id/tvLiveStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Gemini Live: Off"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Zoom Controls Overlaid Right-Center -->
        <LinearLayout
            android:id="@+id/layoutZoomControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_translucent_badge"
            android:orientation="vertical"
            android:padding="6dp"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnZoom1x"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="1x"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="0dp"
                app:cornerRadius="22dp"
                app:backgroundTint="#408B5CF6" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnZoom2x"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:text="2x"
                android:textColor="#E0E0FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="0dp"
                app:cornerRadius="22dp"
                app:backgroundTint="#00000000" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnZoom5x"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:text="5x"
                android:textColor="#E0E0FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="0dp"
                app:cornerRadius="22dp"
                app:backgroundTint="#00000000" />
        </LinearLayout>

        <!-- Bottom Container: AI Result Card + Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#A0000000">

            <!-- AI Insight Result Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#1F1B2E"
                app:strokeColor="#5B4296"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_sparkles"
                            app:tint="#A78BFA"
                            android:contentDescription="AI Icon" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Live Gemini AI Discovery"
                            android:textColor="#F3E8FF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyText"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            app:icon="@drawable/ic_copy"
                            app:iconTint="#C4B5FD"
                            android:contentDescription="@string/btn_copy" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnShareText"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            app:icon="@drawable/ic_share"
                            app:iconTint="#C4B5FD"
                            android:contentDescription="@string/btn_share" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="#3A3258" />

                    <TextView
                        android:id="@+id/tvDescriptionResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#ECECF9"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"
                        android:textIsSelectable="true"
                        tools:text="Point your camera at an object or scene to get an excited Gemini analysis!" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Loading Indicator Bar -->
            <LinearLayout
                android:id="@+id/layoutLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="8dp"
                android:visibility="gone">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:indeterminate="true"
                    app:indicatorColor="#A78BFA"
                    app:trackColor="#332B50" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Gemini is analyzing live camera feed..."
                    android:textColor="#D8B4FE"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Bottom Controls Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleFlash"
                    style="@style/Widget.Material3.Button.Icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:icon="@drawable/ic_flash"
                    app:backgroundTint="#3A3A4A"
                    app:iconTint="#FFFFFF"
                    android:contentDescription="@string/btn_flash" />

                <!-- Prominent Gemini Live Toggle / Analyze Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleGeminiLive"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="6dp"
                    android:text="Turn On Gemini AI"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_sparkles"
                    app:iconSize="20dp"
                    app:backgroundTint="#8B5CF6"
                    app:cornerRadius="28dp" />

                <!-- Turn Off Gemini Button (Visible in Manual Mode when Gemini is ON) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTurnOffGemini"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginEnd="6dp"
                    android:text="Turn Off"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="12dp"
                    android:visibility="gone"
                    app:backgroundTint="#EF4444"
                    app:cornerRadius="28dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSwitchCamera"
                    style="@style/Widget.Material3.Button.Icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:icon="@drawable/ic_switch_camera"
                    app:backgroundTint="#3A3A4A"
                    app:iconTint="#FFFFFF"
                    android:contentDescription="@string/btn_switch_camera" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickGallery"
                    style="@style/Widget.Material3.Button.Icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    app:icon="@drawable/ic_gallery"
                    app:backgroundTint="#3A3A4A"
                    app:iconTint="#FFFFFF"
                    android:contentDescription="@string/btn_choose_gallery" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
